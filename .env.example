# Copy this file to .env and fill in your key.

# "anthropic" (Claude) or "openai"
LLM_PROVIDER=anthropic

# Only the key for the provider you use is needed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the default model for the provider
# LLM_MODEL=

# Optional settings
# MAX_TOKENS=1024
# MAX_HISTORY_MESSAGES=20
# SYSTEM_PROMPT=You are a helpful assistant.
